# Copy to .env for local development.

# URL of the chat proxy server (see server/README.md). In production,
# if you route /api on the same domain as the static site (recommended
# for DigitalOcean App Platform — see server/README.md), you can omit
# this and it will default to same-origin /api/chat instead.
VITE_CHAT_API_URL=http://localhost:3001/api/chat

# Base URL of the Blue Ocean FastAPI backend (backend/). Defaults to
# http://localhost:8000 if unset — MUST be set to the real deployed
# backend URL in production, or every backend-dependent feature
# (destinations, contact form, auth, admin) silently fails there.
VITE_API_URL=http://localhost:8000

# Optional last-resort fallback: if the FastAPI backend above is itself
# unreachable (not just its database — see backend's FALLBACK_DATABASE_URL
# for that case), the frontend queries this Supabase project directly for
# read-only content (currently: destinations, regions). Leave both blank
# to disable — the app behaves exactly as if this feature didn't exist.
#
# VITE_SUPABASE_PUBLISHABLE_KEY is the public/anon key from Supabase's
# dashboard (Settings -> API) — safe to expose in frontend code, unlike a
# database password. For this to actually return data, the same Supabase
# project must (a) have the schema migrated and seeded — see backend's
# FALLBACK_DATABASE_URL docs in backend/README.md — and (b) have Row
# Level Security policies allowing public SELECT on the `destinations`
# and `regions` tables (RLS blocks anonymous reads by default).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
