{
  "appId": "so.blueocean.app",
  "appName": "Blue Ocean",
  "webDir": "dist",
  "backgroundColor": "#0A2540",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": false,
      "backgroundColor": "#0A2540",
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "overlaysWebView": false
    },
    "Keyboard": {
      "resize": "body"
    }
  }
}
