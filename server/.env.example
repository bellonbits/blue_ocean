# Copy this file to .env and fill in real values. Never commit .env.

# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional — defaults to openai/gpt-oss-120b if unset. Avoid groq/compound
# and groq/compound-mini here: they fan out to several internal model
# calls per turn and hit the (quite low) free-tier rate limit almost
# immediately with a grounding-heavy system prompt like this one's.
# See https://console.groq.com/docs/models for current model names.
GROQ_MODEL=openai/gpt-oss-120b

# Port the proxy listens on.
PORT=3001

# Comma-separated list of allowed frontend origins, e.g.:
# ALLOWED_ORIGINS=https://blueoceansomalia.com,https://www.blueoceansomalia.com
# Leave unset only for local development (allows all origins).
ALLOWED_ORIGINS=http://localhost:5173
